# ============ PandaWiki 本地部署配置（复制为 .env 后修改密码）============
# 用法：cp .env.example .env，然后修改下面的密码

# 时区
TIMEZONE=Asia/Shanghai

# 容器网段（后端代码硬编码依赖此网段：NATS=.13, RAG=.18, minio=.12 等，请勿修改）
SUBNET_PREFIX=169.254.15

# 中间件密码（部署时请改成随机强密码）
POSTGRES_PASSWORD=change-me-postgres-password
NATS_PASSWORD=change-me-nats-password
JWT_SECRET=change-me-jwt-secret
S3_SECRET_KEY=change-me-minio-secret-key
QDRANT_API_KEY=change-me-qdrant-api-key
REDIS_PASSWORD=change-me-redis-password

# 管理后台登录密码
ADMIN_PASSWORD=change-me-admin-password

# 管理后台访问端口（HTTPS）
ADMIN_PORT=2443
